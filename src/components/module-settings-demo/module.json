{
  "name": "example/module-settings-demo",
  "title": "Module Settings Demo",
  "titles": "Module Settings Demos",
  "moduleIcon": "example/module-settings-demo",
  "moduleClassName": "example_module_settings_demo",
  "moduleOrderClassName": "example_module_settings_demo",
  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "layout": {
          "selector": "{{selector}} .example_module_settings_demo__inner"
        }
      },
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Module Settings Demo"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "elements": {},
          "html": {},
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "layout": {},
          "background": {},
          "bodyFont": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "textInput": {
      "type": "object",
      "selector": "{{selector}} .example_module_settings_demo__text-input",
      "attributes": {
        "class": "example_module_settings_demo__text-input"
      },
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Your text goes here"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentContent",
            "priority": 10,
            "render": true,
            "attrName": "textInput.innerContent",
            "label": "Text Input",
            "description": "Plain text field stored as a string.",
            "features": {
              "sticky": false,
              "dynamicContent": {
                "type": "text"
              }
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "richText": {
      "type": "object",
      "selector": "{{selector}} .example_module_settings_demo__rich-text",
      "elementType": "content",
      "attributes": {
        "class": "example_module_settings_demo__rich-text"
      },
      "tagName": "div",
      "inlineEditor": "richText",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentContent",
            "priority": 20,
            "render": true,
            "attrName": "richText.innerContent",
            "label": "Rich Text",
            "description": "Rich text field stored as HTML.",
            "features": {
              "sticky": false,
              "dynamicContent": {
                "type": "text"
              }
            },
            "component": {
              "name": "divi/richtext",
              "type": "field"
            }
          }
        }
      }
    },
    "selectField": {
      "type": "object",
      "selector": "{{selector}} .example_module_settings_demo__select",
      "attributes": {
        "class": "example_module_settings_demo__select"
      },
      "default": {
        "innerContent": {
          "desktop": {
            "value": "option_b"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentContent",
            "priority": 30,
            "render": true,
            "attrName": "selectField.innerContent",
            "label": "Select",
            "description": "Select field stored as an option key.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false
            },
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "option_a": {
                    "label": "Option A"
                  },
                  "option_b": {
                    "label": "Option B"
                  },
                  "option_c": {
                    "label": "Option C"
                  }
                }
              }
            }
          }
        }
      }
    },
    "checkboxesField": {
      "type": "object",
      "selector": "{{selector}} .example_module_settings_demo__checkboxes",
      "attributes": {
        "class": "example_module_settings_demo__checkboxes"
      },
      "default": {
        "innerContent": {
          "desktop": {
            "value": ["option_2"]
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentContent",
            "priority": 40,
            "render": true,
            "attrName": "checkboxesField.innerContent",
            "label": "Checkboxes",
            "description": "Checkboxes field stored as an array of option keys.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false
            },
            "component": {
              "name": "divi/checkboxes",
              "type": "field",
              "props": {
                "options": [
                  {
                    "value": "option_1",
                    "label": "Option 1"
                  },
                  {
                    "value": "option_2",
                    "label": "Option 2"
                  },
                  {
                    "value": "option_3",
                    "label": "Option 3"
                  },
                  {
                    "value": "option_4",
                    "label": "Option 4"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "textInput": {
      "label": "Text Input",
      "subName": "textInput",
      "selectorSuffix": " .example_module_settings_demo__text-input"
    },
    "richText": {
      "label": "Rich Text",
      "subName": "richText",
      "selectorSuffix": " .example_module_settings_demo__rich-text"
    },
    "selectField": {
      "label": "Select",
      "subName": "selectField",
      "selectorSuffix": " .example_module_settings_demo__select"
    },
    "checkboxesField": {
      "label": "Checkboxes",
      "subName": "checkboxesField",
      "selectorSuffix": " .example_module_settings_demo__checkboxes"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentContent": {
        "panel": "content",
        "priority": 10,
        "groupName": "content",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      }
    }
  }
}
